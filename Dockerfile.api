FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[dev]"

COPY mosaic_core/ ./mosaic_core/
COPY data/ ./data/

EXPOSE 8000

CMD ["uvicorn", "mosaic_core.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
