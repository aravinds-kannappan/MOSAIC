# ─── MOSAIC Assistant (web demo) ──────────────────────────────────────────────
# Powers the in-console Claude assistant at /api/chat (set this on Vercel).
ANTHROPIC_API_KEY=

# ─── LLM Extractor ────────────────────────────────────────────────────────────
# Use either Ollama (local) or an OpenAI-compatible API
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:70b

# Fallback: any OpenAI-compatible endpoint (OpenAI, Together, Groq, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ─── Data Sources ─────────────────────────────────────────────────────────────
# CDC NWSS Socrata API (no key required, but higher rate limits with one)
SOCRATA_APP_TOKEN=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mosaic:mosaic@localhost:5432/mosaic
# Or use SQLite for local dev:
# DATABASE_URL=sqlite:///./mosaic.db

# ─── API ──────────────────────────────────────────────────────────────────────
MOSAIC_API_SECRET=change-me-in-production
MOSAIC_API_URL=http://localhost:8000

# ─── Web App ──────────────────────────────────────────────────────────────────
# If set, the Next.js API routes proxy to this backend URL
# Leave unset to use built-in demo data (default for Vercel)
NEXT_PUBLIC_MOSAIC_API_URL=

# ─── Inference ────────────────────────────────────────────────────────────────
# Number of NUTS sampling chains (reduce for faster dev)
MCMC_NUM_CHAINS=4
MCMC_NUM_WARMUP=1000
MCMC_NUM_SAMPLES=2000
# Use ADVI instead of NUTS for sub-minute inference
USE_ADVI=false
